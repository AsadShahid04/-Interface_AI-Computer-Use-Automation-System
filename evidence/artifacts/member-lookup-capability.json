{
  "version": "1.0",
  "id": "provisional-member-lookup",
  "name": "member_lookup_demo_bank",
  "description": "Look up a member by ID and extract account balances",
  "domain": "localhost:3000",
  "createdAt": "2026-09-08T20:43:00.000Z",
  "updatedAt": "2026-09-08T20:43:00.000Z",
  "parameters": [
    {
      "name": "memberId",
      "type": "string",
      "description": "Member ID to look up",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "step_1",
      "action": {
        "type": "type",
        "target": "input[name=\"id\"]",
        "value": "{memberId}",
        "description": "Enter member ID in search field"
      },
      "expectedOutcome": "Member ID populated in input field"
    },
    {
      "id": "step_2",
      "action": {
        "type": "click",
        "target": "button:Search Member",
        "description": "Click search button to submit query"
      },
      "expectedOutcome": "Navigate to member details page or error message"
    },
    {
      "id": "step_3",
      "action": {
        "type": "wait",
        "timeout": 1000,
        "description": "Wait for page to stabilize"
      },
      "expectedOutcome": "Member details displayed or error shown"
    }
  ],
  "outputs": [
    {
      "name": "savingsBalance",
      "type": "string",
      "pattern": "Savings Balance[:\\s]*\\$?([0-9,]+\\.\\d{2})",
      "required": true
    },
    {
      "name": "checkingBalance",
      "type": "string",
      "pattern": "Checking Balance[:\\s]*\\$?([0-9,]+\\.\\d{2})",
      "required": false
    },
    {
      "name": "memberName",
      "type": "string",
      "pattern": "Full Name[:\\s]*\"([^\"]+)\"",
      "required": false
    }
  ],
  "successCriteria": [
    "URL contains /member?id=",
    "savingsBalance field extracted successfully",
    "No error message present in page text"
  ],
  "metadata": {
    "provisional": true,
    "discoveryStatus": "pending_live_run",
    "tags": [
      "demo-bank",
      "provisional"
    ]
  }
}
